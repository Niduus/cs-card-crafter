<Project>
	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<LangVersion>latest</LangVersion>
		<Version>0.1.13</Version>
		<Authors>Niduus</Authors>
		<!-- The game repo, a git submodule. Its engine-free code (cards, rules, board) is compiled into the core. -->
		<GameRoot>$(MSBuildThisFileDirectory)external/chaos_spells_sbox/</GameRoot>
	</PropertyGroup>
</Project>
